{
  "name": "mailhub-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Packaged desktop build of MailHub (Electron + embedded Postgres) - free, one-click install.",
  "license": "GPL-3.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "sync": "node scripts/sync-mailhub.js",
    "prebuild:win": "pnpm run sync",
    "build:win": "electron-builder --win",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File build-release.ps1"
  },
  "dependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "@embedded-postgres/windows-x64",
      "embedded-postgres"
    ]
  }
}
